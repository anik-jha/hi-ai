FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends cron \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node . .
ENV HI_AI_TEST_CRON=1
# cron needs root to start; tests and all installed schedules belong to node.
CMD ["sh", "-c", "cron && exec runuser -u node -- npm test"]
